# Class AId Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================================
# Supabase (Client-side - safe for browser, read-only with RLS)
# ============================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ============================================================
# Supabase (Server-side only - Pages Functions env vars)
# NEVER prefix these with NEXT_PUBLIC_
# ============================================================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ============================================================
# Groq (Server-side only - Pages Functions env vars)
# ============================================================
GROQ_API_KEY=your-groq-api-key-here

# ============================================================
# Cloudflare (Server-side only - for Workers AI embeddings)
# ============================================================
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id-here
